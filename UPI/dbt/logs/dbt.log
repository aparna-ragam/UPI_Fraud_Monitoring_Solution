    beneficiary_vpa,
    beneficiary_created_date,
    bank_name,
    risk_rating,
    hash_diff,
    created_load_id,
    created_date_time,
    null as updated_date_time,
    true as is_current
    from source


    
    where created_date_time > (select coalesce(max(created_date_time), '1900-01-01'::timestamp)
