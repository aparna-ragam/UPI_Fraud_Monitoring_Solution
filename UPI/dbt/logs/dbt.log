)

select
   collect_request_id,
    customer_id,
    request_amount,
    request_time,
    request_status,
    request_hour,
    request_day_of_week,
    request_risk_rating,
    hash_diff,
    created_load_id,
    current_timestamp() as created_date_time,
    null as updated_date_time,
    true as is_current
