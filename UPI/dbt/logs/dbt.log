            WHEN RISK_SCORE >= 85 THEN 'HIGH'
            WHEN RISK_SCORE >= 70 THEN 'MEDIUM'
            ELSE 'LOW'
        END,'^') || '|' ||
        coalesce('OPEN','^')
    ) as hash_diff,
    load_ts
FROM UPI_FRAUD_MONITORING_DB.analytics.gld_rule_results)
select alert_id,
       fraud_code,
       customer_id,
       transaction_id,
       risk_score,
       alert_severity,
       alert_status,
       hash_diff,
       load_ts
from result_set
  )
