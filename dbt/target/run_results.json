join (select beneficiary_id,sum(txn_amount) as txn_amount,count(distinct customer_id) cnt from UPI_FRAUD_MONITORING_DB.TRANSFORM.sl_transaction where is_current='TRUE' group by beneficiary_id) t\non b.beneficiary_id=t.beneficiary_id\n)\n\nselect\n    beneficiary_id,\n    customer_id,\n    beneficiary_name,\n    beneficiary_vpa,\n    beneficiary_created_date,\n    bank_name,\n    risk_rating,\n    hash_diff,\n    created_load_id,\n    current_timestamp() as created_date_time,\n    null as updated_date_time,\n    true as is_current\n    from source", "relation_name": "UPI_FRAUD_MONITORING_DB.TRANSFORM.sl_beneficiary", "batch_results": null, "overload_results": null}], "elapsed_time": 5.354429006576538, "args": {"use_fast_test_edges": false, "log_file_max_bytes": 10485760, "use_catalogs_v2": false, "require_corrected_analysis_fqns": false, "state_modified_compare_vars": false, "use_v2_parser": false, "hints_enabled": true, "defer": false, "send_anonymous_usage_stats": true, "use_colors_file": true, "show_resource_report": false, "require_resource_names_without_spaces": true, "require_valid_schema_from_generate_schema_name": false, "require_nested_cumulative_type_params": true, "require_all_warnings_handled_by_warn_error": true, "strict_mode": false, "cache_selected_only": false, "version_check": true, "log_path": "C:\\Users\\aparn\\UPI_Fraud_Monitoring_Solution\\UPI_Fraud_Monitoring_Solution\\dbt\\logs", "require_ref_searches_node_package_before_root": false, "introspect": true, "log_level": "info", "favor_state": false, "allow_jinja_file_extensions": false, "show_all_deprecations": false, "require_unique_project_resource_names": false, "require_generic_test_arguments_property": true, "require_explicit_package_overrides_for_builtin_materializations": true, "snowflake_projects_otel": false, "state_modified_compare_more_unrendered_values": true, "invocation_command": "dbt run --select sl_beneficiary.sql", "which": "run", "log_format_file": "debug", "require_yaml_configur