    trim(DEVICE_FINGERPRINT) as DEVICE_FINGERPRINT,
    TRUSTED_FLAG,
    trim(SOURCE_FILE_NAME) as SOURCE_FILE_NAME,
    cast(CREATED_LOAD_ID as number(38,10)) as CREATED_LOAD_ID,
    CREATED_DATE_TIME,
