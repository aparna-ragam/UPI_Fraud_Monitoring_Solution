	coalesce(cast(change_hour as varchar),'^') || '|' ||
	coalesce(change_day_of_week,'^') || '|' ||
	coalesce(cast(d.device_risk_score as varchar),'^') || '|' ||
    coalesce(password_change_risk,'^')
    ) as hash_diff
